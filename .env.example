# Connection string de Neon (Dashboard → Connect → Copy snippet).
# En local: copia este archivo a .env.local y pega tu URL.
DATABASE_URL=

# Mismo secreto que Goi Web/server en desarrollo (JWT compatible).
JWT_SECRET=dev-jwt-secret-change-in-production

# Resend (email transaccional: verificación + reset de contraseña)
RESEND_API_KEY=
EMAIL_FROM=Goi <onboarding@resend.dev>

# URL pública de Goi Web (enlaces en emails)
WEB_APP_URL=http://localhost:5173

# Email de contacto (legales / soporte)
CONTACT_EMAIL=support@example.com

# Dev: devuelve tokens de reset/verify en la respuesta JSON (sin enviar email)
# AUTH_RESET_RETURN_TOKEN=true
